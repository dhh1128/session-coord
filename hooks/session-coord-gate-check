#!/usr/bin/env python3
"""The expensive half of the PreToolUse gate, reached only for git writes.

Refuses exactly one thing: a git command that mutates a working tree or index, run in a tree
another live session is ALSO sitting in. That is the 2026-09-17 near-miss -- `infra:6`'s tree
held `infra:11`'s uncommitted audit and `infra:6` commits with `git add -A`; one more commit
and it would have landed a stranger's work under its own message, silently.

Since 2026-11-02 it lets one shape through even there: `git add`/`git commit` naming every file
explicitly, none claimed by a peer in the tree. See `staging_form` and the DESIGN.md section.

## Why this tokenises instead of matching

The first five versions of this file parsed shell with a regular expression, and review found a
new hole in it every round: `sudo -u daniel git add` slipped past because the wrapper's flag
took a value, `bash -c 'git add -A'` because the write was inside a string, `printf 'x; git add
-A'` was DENIED because a quoted semicolon looked like a command boundary, and
`git commit -m '-C /safe'` was scoped to the wrong tree because an argument looked like an
option. Those are not five bugs. They are one bug -- a regex cannot see quoting -- wearing five
hats, and patching it five times was the wrong answer each time.

`shlex` knows about quoting. Everything below walks tokens.

## What it must get right, in order

**Never miss a write.** A missed write is the collision this whole package exists to prevent.
**Never deny a non-write.** A gate that blocks legitimate work gets switched off, and then it
misses every write. **Never crash.** It runs on every git-ish Bash call in every session, so a
traceback here degrades the whole session; every failure path returns 0 and permits.

Neither of those fallbacks is the repo-wide question any more, and the reversal is worth stating
because the old rule reads as the conservative one. A command that cannot be tokenised is a
write only if a write verb appears in its raw text, and every check names a tree: the caller's
own, plus every directory the command mentions. Asking repo-wide when the tree could not be
named denied EVERY session in the repo, including the ones sitting in their own worktrees doing
what the gate's own remedy tells them to do. The residual gap is a write into a tree nobody
named (`cd $VAR && git add -A`), and that trade is deliberate: a rare miss beats a gate that
refuses compliant sessions, because the second one ends with the gate switched off and then
every write goes through.
"""

import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

CLI = Path(__file__).resolve().parents[1] / "bin" / "session-coord"

# git subcommands that write to the index or the working tree.
#
# `clean` is on this list because of the incident rather than by category, and it is the most
# destructive entry: `git clean -fd` in a shared checkout deletes a peer's UNTRACKED files
# outright and irreversibly, and the 2026-09-17 near-miss involved exactly two untracked files.
# Everything else here stages or rewrites; that one destroys.
WRITE_VERBS = {
    "add", "commit", "merge", "rebase", "checkout", "switch", "stash", "rm", "mv",
    # `pull` is `fetch` plus `merge`, and the merge half lands in the working tree. Its absence
    # was the most embarrassing gap in eleven rounds: the 2026-09-17 incident WAS a session
    # merging origin/main into a branch two others were committing to, and `git pull` is the
    # ordinary way that happens. `fetch` alone is deliberately absent -- it touches no file.
    "pull", "reset", "restore", "cherry-pick", "revert", "apply", "am", "clean",
    # Plumbing that writes the INDEX or the WORKING TREE directly, without going through a verb
    # a human would recognise as staging. `git update-index --add` stages a peer's path with no
    # `git add` anywhere in the command line.
    #
    # Deliberately narrow. A first pass at this list also held `worktree`, `submodule`, `gc`,
    # `prune`, `update-ref`, `write-tree` and `symbolic-ref`, and the suite immediately caught
    # `git worktree list` -- a read -- being denied. Those either do not touch a peer's files
    # (`update-ref`, `gc`) or have a read as their commonest form (`worktree list`,
    # `submodule status`). Denying them would be the false-refusal failure, which ends with the
    # gate switched off and every real write permitted.
    "update-index", "read-tree", "checkout-index", "sparse-checkout", "filter-branch",
}

# Prefixes that run a command without being one. Each maps to whether its own options may take
# a separate value -- `sudo -u daniel git add` was missed because `-u` consumes `daniel`.
WRAPPERS = {
    "sudo": True, "env": True, "command": False, "builtin": False, "exec": False,
    "nice": True, "ionice": True, "time": False, "nohup": False, "stdbuf": True,
    "setsid": False, "timeout": True, "doas": True,
}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh"}

# Which of each wrapper's options take a SEPARATE value. Treating every option of a wrapper as
# valued -- the old rule -- made `env -i git add -A` and `sudo -E git add -A` read `git` as the
# flag's value and miss the write entirely (Copilot on PR #5). Anything not listed is valueless.
WRAPPER_VALUED = {
    "sudo": {"-u", "--user", "-g", "--group", "-h", "--host", "-p", "--prompt", "-C",
             "--close-from", "-D", "--chdir", "-r", "--role", "-t", "--type", "-U",
             "--other-user", "-T", "--command-timeout", "-R", "--chroot"},
    "env": {"-u", "--unset", "-C", "--chdir", "-S", "--split-string"},
    "nice": {"-n", "--adjustment"},
    "ionice": {"-c", "--class", "-n", "--classdata", "-p", "--pid", "-P", "--pgid", "-u",
               "--uid"},
    "stdbuf": {"-i", "--input", "-o", "--output", "-e", "--error"},
    "timeout": {"-s", "--signal", "-k", "--kill-after"},
    "doas": {"-u", "-C"},
}
# Positional arguments a wrapper takes before the command: `timeout 10 git ...`.
WRAPPER_POSITIONALS = {"timeout": 1}
# Options that run the command somewhere else, or hand it over as a string. Either way the tree
# the write lands in is no longer the one this can name (`env --chdir=/other git add a.md`).
# Options whose value is itself a command line in a language this cannot read: env -S has
# quoting, escapes and `\c` (end of string) of its own, and `env -S 'git\cX' add -A` runs
# `git add -A` (a cross-model review of PR #5). Any use of one makes the segment unreadable.
WRAPPER_STRINGS = {"env": {"-S", "--split-string"}}
WRAPPER_RELOCATES = {"env": {"-C", "--chdir", "-S", "--split-string"},
                     "sudo": {"-D", "--chdir", "-R", "--chroot", "-i", "--login"}}


def _mentions_git_write(tokens):
    """True when the tokens could still run a git write: `git` (by basename) followed, in the
    same token or a later one, by a write verb. The backstop for a wrapper this could not fully
    read. Bare mention of the word -- `printf git`, `grep -r git .` -- is not enough, because
    refusing those in a shared tree is the false refusal that gets a gate switched off (hostile
    fix pass on PR #5)."""
    words = []
    for t in tokens:
        try:
            words += shlex.split(t)
        except ValueError:
            words += t.split()
    for k, w in enumerate(words):
        # An option's attached value can be the command: `--split=git add -A`, `-iSgit add`.
        is_git = (os.path.basename(w.split("=", 1)[-1]) == "git"
                  or (w.startswith("-") and w.endswith("git")))
        if is_git and any(v in WRITE_VERBS for v in words[k + 1:]):
            return True
    return False


def _mentions_git(tokens):
    """Any `git` at all, spelling aside. For a wrapper that relocates the command or carries it
    as a string (`env -C`, `env -S`), which re-parses its argument with quoting and escapes of
    its own: `env -S 'git "add" -A'` hid its verb from a whitespace split (hostile fix pass on
    PR #5). Nothing reads such a command reliably, so mentioning git is enough to refuse."""
    # As a WORD, after quotes and backslashes are gone: a bare substring refused
    # `env -C / printf digital-camera` (hostile fix pass four). `/usr/bin/git`, `g""it` and
    # env -S's `git\_add` still match; `digital` and `.gitignore` do not.
    text = " ".join(tokens).replace('"', "").replace("'", "").replace("\\", "")
    if re.search(r"(?<![A-Za-z0-9_.-])git(?![A-Za-z0-9.-])", text):
        return True
    return _mentions_git_write(tokens)  # git glued to an option letter: `-iSgit add -A`


def _long_option(name, key):
    """`key` as the wrapper's full long option, the way GNU getopt reads it.

    getopt accepts any unique prefix of a long option, so `env --split=...` IS
    `--split-string` and `env --ch=sub` IS `--chdir`; exact matching let both through (a
    cross-model review of PR #5). An ambiguous prefix returns itself, which matches nothing
    and is then treated as moving the command, the fail-closed reading.
    """
    if not key.startswith("--") or len(key) < 3:
        return key, False
    known = {o for o in WRAPPER_VALUED.get(name, set()) | WRAPPER_RELOCATES.get(name, set())
             if o.startswith("--")}
    if key in known:
        return key, False
    hits = [o for o in known if o.startswith(key)]
    if len(hits) == 1:
        return hits[0], False
    return key, len(hits) > 1

# git's own options, before the subcommand. Those that take a separate value must be known, or
# their value gets read as the subcommand.
GIT_OPTS_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"}

# Environment variables that move where a write lands.
GIT_ENV_REDIRECTS = {"GIT_WORK_TREE", "GIT_DIR", "GIT_INDEX_FILE", "GIT_COMMON_DIR"}

OPERATORS = {";", "&&", "||", "|", "&", "\n"}


def _logical_lines(command):
    """Split on newlines that are NOT inside quotes, skipping heredoc bodies.

    `str.splitlines` cuts through a quoted string and through a heredoc, and both are ordinary
    things to write: a multi-line message argument, and `cat <<EOF ... EOF` whose body contains
    example commands. Cutting them produced fragments that either failed to lex -- assumed to
    be writes -- or looked like commands nobody ran.
    """
    lines, buf = [], []
    quote = None          # "'" or '"' while inside one
    heredoc = None        # the delimiter we are waiting for, while inside a body
    heredoc_tabs = False  # `<<-` strips leading TABS from the terminator; `<<` strips nothing
    i, n = 0, len(command)
    while i < n:
        ch = command[i]
        if heredoc is not None:
            if ch == "\n":
                # Match the delimiter the way the shell does. `.strip()` here accepted any
                # body line with spaces around the delimiter as the terminator -- so a heredoc
                # containing an indented ` EOF ` ended early, and the rest of its body was then
                # scanned as commands and could be falsely denied. That is the false-refusal
                # failure this function exists to fix, reintroduced inside the fix.
                line = "".join(buf)
                if (line.lstrip("\t") if heredoc_tabs else line) == heredoc:
                    heredoc = None
                buf = []
            else:
                buf.append(ch)
            i += 1
            continue
        if quote:
            buf.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < n:
                buf.append(command[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            buf.append(ch)
            i += 1
            continue
        if ch == "\\" and i + 1 < n:
            buf.append(ch)
            buf.append(command[i + 1])
            i += 2
            continue
        if command[i:i + 2] == "<<":
            j = i + 2
            dash = j < n and command[j] == "-"
            if dash:
                j += 1
            while j < n and command[j] in " \t":
                j += 1
            k, q = j, None
            if k < n and command[k] in "\"'":
                q = command[k]
                k += 1
            delim = []
            while k < n and (command[k].isalnum() or command[k] in "_-."):
                delim.append(command[k])
                k += 1
            if q and k < n and command[k] == q:
                k += 1
            if delim:
                # The rest of THIS line is still a command; the body starts after the newline.
                buf.append(command[i:k])
                while k < n and command[k] != "\n":
                    buf.append(command[k])
                    k += 1
                lines.append("".join(buf))
                buf = []
                heredoc, heredoc_tabs = "".join(delim), dash
                i = k + 1
                continue
        if ch == "\n":
            lines.append("".join(buf))
            buf = []
            i += 1
            continue
        buf.append(ch)
        i += 1
    if buf:
        line = "".join(buf)
        # A heredoc's terminator on the last line has no newline after it, so the loop above
        # never matched it; it is the end of the body, not a command.
        if heredoc is None or (line.lstrip("\t") if heredoc_tabs else line) != heredoc:
            lines.append(line)
    return lines


class Unparseable(Exception):
    """The command could not be tokenised.

    `analyse` then decides on the RAW TEXT: a write verb in it means assume a write, and its
    absence means this is not a write at all. It used to mean "assume a write, ask widely"
    unconditionally, which refused ordinary multi-line commands containing no git.
    """


def _segments(command):
    """Split a command line into pipeline segments, respecting quotes.

    `shlex` with `punctuation_chars` emits operators as their own tokens, so a `;` inside a
    quoted string stays part of its word -- which is the whole reason `printf 'x; git add -A'`
    must not read as two commands.

    Lines are split FIRST, because shlex treats a newline as ordinary whitespace and never
    emits it as an operator. Without this, a perfectly normal multi-line Bash call --

        echo starting
        git add -A

    -- lexes into a single argv beginning with `echo`, `_git_write` never sees the second
    command, and the write goes ungated. Multi-line commands are the house style in this
    environment rather than an edge case, so that was a wide-open door.

    Newlines are found with a quote-aware scan rather than `str.splitlines`, and heredoc bodies
    are skipped. Round seven split on every newline and accepted the consequence -- a quoted
    multi-line string broke, raised Unparseable, and the caller assumed a write. That looked
    like a safe trade until it was measured against real use: a peer session's `session-coord
    msg` was refused because its MESSAGE spanned two lines, so the tool's own inter-session
    channel was blocked by the tool's own gate. Then the author's own heredoc was refused, for
    containing `git add -A` as example text inside `<<'PYEOF'`. A multi-line message with no
    git in it at all was refused too, which is the tell that the trade was never about git.

    That is the false-refusal failure, and it is the one that ends with the gate switched off.
    """
    out = []
    for line in _logical_lines(command):
        if not line.strip():
            continue
        lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        try:
            tokens = list(lexer)
        except ValueError as e:  # unbalanced quote, trailing backslash, a quoted newline
            raise Unparseable(str(e)) from e
        current = []
        for tok in tokens:
            if tok in OPERATORS:
                if current:
                    out.append(current)
                current = []
            else:
                current.append(tok)
        if current:
            out.append(current)
    return out


def _strip_prefix(argv):
    """Drop leading assignments and wrappers. Returns (argv, env_redirects_seen)."""
    rest, redirects, _ = _strip_prefix_ex(argv)
    return rest, redirects


def _strip_prefix_ex(argv):
    """(argv, redirected, wrapped): `_strip_prefix`, plus whether any wrapper was removed."""
    redirects, wrapped, unreadable = False, False, False
    i = 0
    while i < len(argv):
        tok = argv[i]
        if "=" in tok and not tok.startswith("-") and tok.split("=", 1)[0].isidentifier():
            if tok.split("=", 1)[0] in GIT_ENV_REDIRECTS:
                redirects = True
            i += 1
            continue
        name = os.path.basename(tok)
        if name in WRAPPERS:
            wrapped = True
            valued = WRAPPER_VALUED.get(name, set())
            moves = WRAPPER_RELOCATES.get(name, set())
            i += 1
            while i < len(argv) and argv[i].startswith("-"):
                opt = argv[i]
                if opt == "--":
                    i += 1
                    break
                if not opt.startswith("--") and len(opt) > 2:
                    # A short cluster: `-iC/tmp`, `-Eu daniel`. Walk it the way getopt does --
                    # each letter an option until one takes a value, which is the rest of the
                    # cluster or, if none is left, the next token. Reading only the first
                    # letter hid `-C` inside `-iC/tmp` (hostile fix pass on PR #5).
                    for j, ch in enumerate(opt[1:], 1):
                        flag = "-" + ch
                        if flag in WRAPPER_STRINGS.get(name, set()):
                            unreadable = True
                        if flag in moves:
                            redirects = True
                        if flag in valued:
                            if j == len(opt) - 1 and i + 1 < len(argv):
                                i += 1
                            break
                    i += 1
                    continue
                key, ambiguous = _long_option(name, opt.split("=", 1)[0])
                if key in WRAPPER_STRINGS.get(name, set()):
                    unreadable = True
                if ambiguous or key in moves:
                    redirects = True
                if key in valued and "=" not in opt and i + 1 < len(argv):
                    i += 1  # the flag's value, e.g. `sudo -u daniel`
                i += 1
            i += WRAPPER_POSITIONALS.get(name, 0)
            continue
        break
    if unreadable:
        return argv[i:], "unreadable", wrapped
    return argv[i:], redirects, wrapped


def _git_write(argv):
    """(is_write, explicit_tree, redirected) for one already-prefix-stripped segment.

    `explicit_tree` is the argument of a single unambiguous `-C`; `redirected` says the write
    lands somewhere this cannot name. Both feed the scoping decision.
    """
    if not argv or os.path.basename(argv[0]) != "git":
        return False, None, False
    trees, redirected = [], False
    i = 1
    while i < len(argv):
        tok = argv[i]
        if not tok.startswith("-"):
            # Two `-C`s is ambiguous rather than absent: git applies them cumulatively, and
            # answering "no explicit tree" would have let the caller's cwd stand in for a
            # directory the write does not land in.
            if len(trees) > 1:
                return tok in WRITE_VERBS, None, True
            return tok in WRITE_VERBS, (trees[0] if trees else None), redirected
        # git accepts the ATTACHED short form too -- `-C/repo`, `-C../other` -- which the
        # exact-match test skipped as an unknown option, leaving the write scoped to the
        # caller's cwd. Normalise it into the separated form before anything else looks.
        if tok.startswith("-C") and tok not in ("-C",) and not tok.startswith("-C="):
            trees.append(tok[2:])
            i += 1
            continue
        key = tok.split("=", 1)[0]
        if key in ("-C", "--work-tree", "--git-dir", "--namespace"):
            value = tok.split("=", 1)[1] if "=" in tok else (
                argv[i + 1] if i + 1 < len(argv) else "")
            if key == "-C" and "$" not in value:
                trees.append(value)
            else:
                # A --work-tree/--git-dir moves the write somewhere -C cannot describe, and a
                # value still carrying a `$` is a variable shlex does not expand -- an
                # unexpanded name is not an answer, and guessing it would scope the check to a
                # directory that does not exist.
                redirected = True
            i += 1 if "=" in tok else 2
            continue
        if key in GIT_OPTS_WITH_VALUE:
            i += 1 if "=" in tok else 2
            continue
        i += 1
    return False, None, redirected


def candidate_trees(command, cwd):
    """Every directory this command mentions that could be the tree it writes to.

    Used when `analyse` cannot name one. Falling back to "no hint" made `cmd_check` resolve the
    repo from the caller's cwd, so `cd /other/repo && git add -A` asked THIS repo's board about
    a collision in a different one -- conservative within the wrong repository is not
    conservative. Every candidate gets its own question instead.
    """
    out = []
    try:
        segments = _segments(command)
    except Unparseable:
        return out
    for argv in segments:
        argv, _ = _strip_prefix(argv)
        if not argv:
            continue
        if os.path.basename(argv[0]) in ("cd", "pushd") and len(argv) > 1:
            out.append(argv[1])
        i = 0
        while i < len(argv):
            tok = argv[i]
            if tok.startswith("-C") and tok not in ("-C",) and not tok.startswith("-C="):
                out.append(tok[2:])
            elif tok in ("-C", "--work-tree", "--git-dir") and i + 1 < len(argv):
                out.append(argv[i + 1])
            elif tok.startswith(("--work-tree=", "--git-dir=", "-C=")):
                out.append(tok.split("=", 1)[1])
            i += 1
    # Each named directory twice over: as bash's logical `cd` reads it (`..` undoes the last
    # component, symlink or not) and as the kernel does. The board resolves physically, so
    # without the logical spelling `cd link/..` asked the wrong parent (hostile fix pass on
    # PR #7, finding 1).
    named = []
    for p in out:
        if not p or "$" in p:
            continue
        for q in (os.path.normpath(os.path.join(cwd, p)),
                  os.path.realpath(os.path.join(cwd, p))):
            if q != os.path.abspath(cwd) and q not in named:
                named.append(q)
    return named


def analyse(command, cwd):
    """(is_write, workdir_or_None) for a whole command line.

    `workdir_or_None`: the tree the write lands in when that is unambiguous, else None meaning
    "the tree could not be named" -- on which `main` asks about the caller's own tree plus
    every directory the command mentions, never the repo-wide question.

    Raises nothing. An unparseable command is a write only when a write verb appears in its raw
    text; without one it is reported as a non-write, so the checker agrees with the bash
    prefilter that short-circuits on the same absence.
    """
    try:
        segments = _segments(command)
    except Unparseable:
        # We could not parse it -- but we also never IDENTIFIED a write in it, and denying on
        # that basis refused ordinary multi-line commands with no git in them at all.
        #
        # That refusal was invisible in production only because the bash prefilter short-circuits
        # when the payload contains no `git`, which meant the prefilter was quietly load-bearing
        # for CORRECTNESS while documented as an optimisation. Anyone widening it would have
        # turned the latent refusal live. Found by a peer session probing both layers separately
        # -- the checker alone and the deployed pair -- and getting different answers.
        #
        # So the fallback scans the raw text for a write verb. Present: assume a write and ask
        # widely, which is the conservative answer for something we cannot read. Absent: it is
        # not a write, and the two layers now agree on their own.
        lowered = command.lower()
        if any(f"git {v}" in lowered or f"git-{v}" in lowered for v in WRITE_VERBS):
            return True, None
        return False, None
    write, tree, uncertain = False, None, False

    def _abs(p):
        return os.path.normpath(os.path.join(cwd, p))

    for raw in segments:
        argv, env_redirect, wrapped = _strip_prefix_ex(raw)
        if env_redirect == "unreadable":
            write, uncertain = True, True
            continue
        if wrapped and env_redirect and _mentions_git(raw) and (
                not argv or os.path.basename(argv[0]) != "git"):
            # `env -S 'git add -A'` carries the command as an option's value.
            write, uncertain = True, True
            continue
        if not argv:
            continue
        name = os.path.basename(argv[0])
        if wrapped and name != "git" and _mentions_git_write(argv):
            # A wrapper this cannot fully read left something other than git in front, with
            # git still in the command: assume a write in a tree nobody can name, rather than
            # missing it the way `env -i git add -A` was missed.
            write, uncertain = True, True
            continue
        if name in SHELLS:
            # `bash -c 'git add -A'`. Recurse into the script rather than giving up, but never
            # trust the outer cwd for it -- a nested `cd` is invisible from here.
            for j, tok in enumerate(argv[1:], 1):
                if tok == "-c" and j + 1 < len(argv):
                    inner_write, _ = analyse(argv[j + 1], cwd)
                    if inner_write:
                        write, uncertain = True, True
            continue
        if name in ("cd", "pushd", "popd"):
            uncertain = True  # what follows runs somewhere this cannot name
            continue
        is_write, explicit, redirected = _git_write(argv)
        if is_write:
            write = True
            if env_redirect or redirected:
                uncertain = True
            else:
                # Each write's own tree: its `-C`, or the shell's cwd. A later write does NOT
                # inherit an earlier segment's `-C` -- `git -C /other add a && git commit`
                # commits in THIS tree -- so two different trees means none can be named
                # (Copilot on PR #5).
                here = explicit if explicit is not None else cwd
                if tree is None and not uncertain:
                    tree = here
                elif tree is not None and _abs(tree) != _abs(here):
                    tree, uncertain = None, True
    if not write:
        return False, None
    if uncertain or tree is None:
        return True, None
    return True, tree if os.path.isabs(tree) else os.path.join(cwd, tree)


# ----- explicit paths in a shared tree (2026-11-02) ---------------------------------------
#
# The gate used to refuse every staging command in a shared tree. In a docs repo whose owner's
# rule is to commit straight to main from the main checkout, two sessions were registered, and
# `git add products.md components.md && git commit -s -m ...` was refused although the peer's
# only uncommitted change was a third file neither command named. The user ran the commit by
# hand. The hazard this gate exists for is a BROAD pathspec sweeping a stranger's files; a list
# of explicit files cannot sweep anything. So explicit, unclaimed paths now pass, and the rest
# of this section is what "explicit" has to mean for that to stay true.
#
# Fail-closed throughout: anything this cannot read -- an option it does not know, a path it
# cannot place in the tree, a board or an index it could not ask -- refuses as before.


class Form:
    """What a command would stage, if it is the explicit kind. `ok` False carries `reason`."""

    def __init__(self, ok, reason="", paths=(), added=(), bare_commit=False):
        self.ok, self.reason = ok, reason
        self.paths, self.added, self.bare_commit = tuple(paths), tuple(added), bare_commit


def _no(reason):
    return Form(False, reason)


GLOB_CHARS = set("*?[")
# Characters the gate cannot see through. Braces and backticks are expanded by the shell
# before git runs, so `{a.md,b.md}` reached the board as one literal non-file while git staged
# two (hostile pass on PR #5, finding 2). A backslash is git's pathspec escape, so `README\.md`
# matched `README.md` in git while the claim lookup compared the escaped spelling (finding 3).
OPAQUE_CHARS = set("{}`\\")

# git's own switches for pathspec matching, which make a literal name match differently.
PATHSPEC_ENV = ("GIT_ICASE_PATHSPECS", "GIT_GLOB_PATHSPECS", "GIT_NOGLOB_PATHSPECS",
                "GIT_LITERAL_PATHSPECS")

# Options that change WHAT is staged rather than how, and so turn an explicit list into a
# broad one. Named so the refusal can say why; anything not on an allow-list refuses anyway.
_BROAD = {
    "-A": "stages every change in the tree, including other sessions' files",
    "--all": "stages every change in the tree, including other sessions' files",
    "--no-ignore-removal": "stages every removal in the tree",
    "-u": "stages every tracked change in the tree, including other sessions' files",
    "--update": "stages every tracked change in the tree, including other sessions' files",
    "-a": "commits every tracked change in the tree, including other sessions' files",
    "-p": "is interactive, and picks hunks from files this cannot see",
    "--patch": "is interactive, and picks hunks from files this cannot see",
    "-i": "is interactive (add) or commits the whole index as well (commit)",
    "--interactive": "is interactive, and picks hunks from files this cannot see",
    "--include": "commits the whole index as well as the named paths",
    "-e": "edits a patch of the whole diff",
    "--edit": "edits a patch of the whole diff",
    "--pathspec-from-file": "reads its paths from a file this cannot see",
    "--amend": "rewrites the last commit, which in a shared tree may be another session's",
}

_ADD_FLAGS = {"-v", "--verbose", "-f", "--force", "-N", "--intent-to-add", "-n", "--dry-run"}
_ADD_SHORT = set("vfNn")

_COMMIT_FLAGS = {
    "-s", "--signoff", "--no-signoff", "-q", "--quiet", "-v", "--verbose", "-n", "--no-verify",
    "--verify", "--no-edit", "-o", "--only", "--allow-empty", "--allow-empty-message",
    "--no-gpg-sign", "--gpg-sign", "--no-post-rewrite", "--status", "--no-status",
}
_COMMIT_VALUED = {
    "-m", "--message", "-F", "--file", "-C", "--reuse-message", "-c", "--reedit-message",
    "--author", "--date", "--cleanup", "--trailer", "-t", "--template",
}
_COMMIT_SHORT = set("sqvno")
_COMMIT_SHORT_VALUED = set("mFCct")


def _place(path, gitcwd, root):
    """`path` relative to `root`, or (None, why) when it is not one explicit file there."""
    if not path or path == ".":
        return None, f"`{path or '.'}` names the whole directory"
    if path.startswith(":"):
        return None, f"`{path}` is a magic pathspec, which can match files nobody named"
    if GLOB_CHARS & set(path):
        return None, f"`{path}` is a glob, which can match files nobody named"
    if OPAQUE_CHARS & set(path):
        return None, (f"`{path}` contains a brace, backtick or backslash, which the shell or "
                      "git rewrites before it names a file")
    if "$" in path or path.startswith("~"):
        return None, f"`{path}` was not expanded, so this cannot tell which file it is"
    full = os.path.normpath(os.path.join(gitcwd, path))
    rel = os.path.relpath(full, root)
    if rel == "." or rel.startswith(".." + os.sep) or rel == "..":
        return None, f"`{path}` is not inside this working tree"
    if os.path.isdir(full):
        return None, f"`{path}` is a directory, which stages everything under it"
    rel = rel.replace(os.sep, "/")
    if not os.path.lexists(full):
        # Not on disk, so the filesystem cannot say what it was. A deleted tracked DIRECTORY
        # is still a directory to git, and `git add gone` stages the deletion of everything
        # under it (hostile pass on PR #5, finding 5). Ask the index; fail closed if it can't.
        covered = _index_entries(root, rel)
        if covered is None:
            return None, f"`{path}` is not on disk and the index could not be read to place it"
        if any(e != rel for e in covered):
            return None, f"`{path}` was a directory, which stages everything under it"
    return rel, ""


def _index_entries(root, rel):
    try:
        out = subprocess.run(["git", "-C", root, "ls-files", "-z", "--", f":(literal){rel}"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return [e for e in out.stdout.split("\0") if e]


def _parse_add(args, gitcwd, root):
    """(paths, why, stages). `stages` is False for `-n`/`-N`, which put no content in the
    index and so cannot vouch for a bare commit after them (Copilot on PR #5)."""
    paths, why = _parse_add_paths(args, gitcwd, root)
    opts = [t for t in (args[:args.index("--")] if "--" in args else args) if t.startswith("-")]
    stages = not any(t in ("-n", "--dry-run", "-N", "--intent-to-add")
                     or (not t.startswith("--") and set(t[1:]) & set("nN")) for t in opts)
    return paths, why, stages


def _parse_add_paths(args, gitcwd, root):
    paths, dashdash = [], False
    for tok in args:
        if not dashdash and tok == "--":
            dashdash = True
            continue
        if not dashdash and tok.startswith("-"):
            key = tok.split("=", 1)[0]
            if key in _BROAD:
                return None, f"`git add {key}` {_BROAD[key]}"
            if tok in _ADD_FLAGS:
                continue
            if tok.startswith("-") and not tok.startswith("--") and set(tok[1:]) <= _ADD_SHORT:
                continue
            if not tok.startswith("--"):
                for ch in tok[1:]:
                    if f"-{ch}" in _BROAD:
                        return None, f"`git add -{ch}` {_BROAD['-' + ch]}"
            return None, f"`git add {tok}` is an option this gate does not know"
        rel, why = _place(tok, gitcwd, root)
        if rel is None:
            return None, why
        paths.append(rel)
    if not paths:
        return None, "`git add` names no files"
    return paths, ""


def _parse_commit(args, gitcwd, root):
    paths, dashdash, i = [], False, 0
    while i < len(args):
        tok = args[i]
        i += 1
        if not dashdash and tok == "--":
            dashdash = True
            continue
        if dashdash or not tok.startswith("-") or tok == "-":
            rel, why = _place(tok, gitcwd, root)
            if rel is None:
                return None, why
            paths.append(rel)
            continue
        if tok.startswith("--"):
            key = tok.split("=", 1)[0]
            if key in _BROAD:
                return None, f"`git commit {key}` {_BROAD[key]}"
            if key in _COMMIT_FLAGS:
                continue
            if key in _COMMIT_VALUED:
                if "=" not in tok:
                    i += 1
                continue
            return None, f"`git commit {tok}` is an option this gate does not know"
        # A short cluster: `-s`, `-sm msg`, `-mmsg`, `-SKEYID`.
        cluster = tok[1:]
        for j, ch in enumerate(cluster):
            if ch in _COMMIT_SHORT:
                continue
            if ch in _COMMIT_SHORT_VALUED:
                if j == len(cluster) - 1:
                    i += 1  # the value is the next token
                break       # otherwise the rest of the cluster is the value
            if ch == "S":
                break       # -S[<keyid>], attached or absent
            if f"-{ch}" in _BROAD:
                return None, f"`git commit -{ch}` {_BROAD['-' + ch]}"
            return None, f"`git commit -{ch}` is an option this gate does not know"
    return paths, ""


def staging_form(command, cwd, root):
    """Is `command` nothing but explicit `git add`/`git commit` into the tree at `root`?

    Every git write in it must be one of those two with every path named. Paths come back
    relative to `root`, the tree's top level, because that is how claims and the index name
    them. A bare `git commit` -- no paths -- is accepted only after an explicit `git add` in
    the same command, and only on the gate's word that nothing else is staged
    (`bare_commit`), because on its own it commits whatever is in the index, a peer's
    staging included.
    """
    try:
        is_write, tree = analyse(command, cwd)
        segments = _segments(command)
    except Exception:
        return _no("this command could not be read")
    if not is_write:
        return Form(True)
    if tree is None:
        return _no("this gate could not tell which working tree the command writes to -- a "
                   "`cd`, a `bash -c`, a variable or a git redirect is in the way. Run the git "
                   "command directly, from the session's own directory")
    root = os.path.realpath(root)
    inherited = [v for v in PATHSPEC_ENV if os.environ.get(v)]
    paths, added, bare = [], [], False
    for raw in segments:
        argv, moved, wrapped = _strip_prefix_ex(raw)
        if moved == "unreadable" or (wrapped and moved and _mentions_git(raw)):
            return _no("a wrapper option moves where git runs, or carries the command as a "
                       "string; run git directly")
        if wrapped and argv and os.path.basename(argv[0]) != "git" and _mentions_git_write(
                argv):
            return _no(f"`{' '.join(raw[:3])} ...` hides the git command behind a wrapper this "
                       "gate cannot read; run git directly")
        if not argv or os.path.basename(argv[0]) != "git":
            continue
        if moved:
            return _no("a wrapper option moves where git runs; run git directly")
        prefix = raw[:len(raw) - len(argv)]
        gitcwd, i, opts = os.path.realpath(cwd), 1, []
        while i < len(argv) and argv[i].startswith("-"):
            tok = argv[i]
            if tok == "-C" and i + 1 < len(argv):
                gitcwd = os.path.realpath(os.path.join(gitcwd, argv[i + 1]))
                i += 2
                continue
            if tok.startswith("-C") and not tok.startswith("-C="):
                gitcwd = os.path.realpath(os.path.join(gitcwd, tok[2:]))
                i += 1
                continue
            opts.append(tok)
            key = tok.split("=", 1)[0]
            i += 2 if (key in GIT_OPTS_WITH_VALUE and "=" not in tok) else 1
        if i >= len(argv) or argv[i] not in WRITE_VERBS:
            continue
        # git's global switches and its environment can make a literal name match something
        # else -- `--icase-pathspecs`, `-c core.ignorecase=true`, `GIT_GLOB_PATHSPECS=1` -- so
        # a staging command carrying any of them is not one the gate can read (hostile pass on
        # PR #5, finding 3). `-C` is the one global option it understands.
        if opts:
            return _no(f"`git {opts[0]}` changes how git reads the paths that follow; use no "
                       "global option but `-C`")
        env = [t.split("=", 1)[0] for t in prefix if "=" in t and t.startswith("GIT_")]
        if env or inherited:
            return _no(f"`{(env or inherited)[0]}` is set, which changes how git matches the "
                       "named paths")
        verb, rest = argv[i], argv[i + 1:]
        if verb == "add":
            got, why, stages = _parse_add(rest, gitcwd, root)
            if got is None:
                return _no(why)
            if stages:
                added += got
            paths += got
        elif verb == "commit":
            got, why = _parse_commit(rest, gitcwd, root)
            if got is None:
                return _no(why)
            if got:
                paths += got
            else:
                bare = True
        else:
            return _no(f"`git {verb}` changes files every session in this tree is using")
    if bare and not added:
        return _no("a bare `git commit` commits whatever is already staged, including anything "
                   "another session staged. Name the files: `git commit -s -m '...' -- <file> "
                   "<file>`")
    seen = []
    for p in paths:
        if p not in seen:
            seen.append(p)
    return Form(True, paths=seen, added=added, bare_commit=bare)


def staged_paths(root):
    """Paths staged in `root`'s index, or None when the index could not be read."""
    try:
        out = subprocess.run(["git", "-C", root, "diff", "--cached", "--name-only", "-z"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return tuple(p for p in out.stdout.split("\0") if p)


def ask(tree, cwd, paths=(), session=""):
    """The board's findings for `tree`, or None when the board could not be asked.

    --repo-of as well as --workdir. `git -C /other/repo add -A` issued from here writes to a
    DIFFERENT repository's board, and asking this repo's board about it checked the wrong one
    -- or exited clean because the answer was about a tree nobody here shares.
    """
    argv = [str(CLI), "check", "--json", "--workdir", tree, "--repo-of", tree]
    # `--path=<p>`, never `--path <p>`: argparse read a separate `-peer.md` as an option,
    # exited 2 with nothing on stdout, and that parsed as "no findings" -- authorising a
    # claimed file (hostile pass on PR #5, finding 1). `check --json` always prints a list, so
    # empty output is a failure to ask, not an empty board.
    for p in paths:
        argv.append(f"--path={p}")
    if paths:
        argv.append(f"--session={session or ''}")
    try:
        out = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=15)
        if not out.stdout.strip():
            return None
        found = json.loads(out.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return found if isinstance(found, list) else None


def _explicit_remedy():
    try:
        sys.path.insert(0, str(CLI.parents[1]))
        from sessioncoord.detect import EXPLICIT_REMEDY
        return EXPLICIT_REMEDY
    except Exception:
        return ("Name the files explicitly: `git add <file>` and `git commit -- <file>`; "
                "broad forms stay refused.")


def deny(reason):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    return 0


def main():
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    if not isinstance(payload, dict):
        return 0
    tool_input = payload.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(command, str):
        return 0
    cwd = payload.get("cwd") or os.getcwd()
    if not isinstance(cwd, str):
        return 0
    if not CLI.exists():
        return 0

    # A leading literal `cd /path && git ...` (or `;`, a newline, `pushd`) writes into /path
    # exactly as `git -C /path` would, so it is resolved the same way before anything else
    # looks. See `_literal_cd` for what counts as literal. Without this the gate asked about
    # the SESSION's tree, and a commit into an unrelated repo was refused with another repo's
    # shared-tree finding and told to take a worktree there (2026-11-02, reported by the
    # session that hit it).
    #
    #
    # `behind` is every directory a hop left: the session's own, and each earlier hop. The
    # write can land back in one of them if a followed `cd` might not hold (`_literal_cd`'s
    # third value) or if the rest cannot be read -- a `popd` returns through a `pushd` stack
    # (Copilot on PR #7). In either case each of them is asked too.
    behind, unsure = [], False
    try:
        hop = _literal_cd(command, cwd)
        while hop is not None:
            behind.append(cwd)
            cwd, command, sure = hop
            unsure = unsure or not sure
            hop = _literal_cd(command, cwd)
    except Exception:
        unsure = True

    try:
        is_write, workdir = analyse(command, cwd)
    except Exception:
        return 0  # never be the thing that breaks a session
    if not is_write:
        return 0

    # ALWAYS scoped to a named tree -- never the unscoped repo-wide question.
    #
    # Asking repo-wide when the tree could not be named looked like the conservative move and
    # was the worst false positive in the tool. A repo-wide answer includes the main checkout's
    # shared-tree finding, so ANY command whose tree could not be named denied EVERY session in
    # the repo -- including the ones sitting in their own worktrees, who had done exactly what
    # the gate's own remedy tells them to do. Two peer sessions hit it within minutes of each
    # other, both compliant, and one could not report it because the report tripped the same bug.
    #
    # So: the caller's own tree, plus every directory the command names. The residual gap is a
    # write into a tree nobody named -- `cd $VAR && git add -A`. That is a real miss and it is
    # the right trade: a rare miss, against denying every compliant session on every ambiguous
    # command, which is how a gate gets switched off -- after which every write goes through.
    if workdir is not None:
        findings = ask(workdir, cwd) or []
    else:
        findings = ask(cwd, cwd) or []
        for cand in candidate_trees(command, cwd)[:8]:
            findings = findings + (ask(cand, cwd) or [])
    # Every directory the write may fall back into. A shared one refuses outright: the
    # explicit-path allowance reads paths against the tree the command names, which is not
    # the one they would be staged in if the `cd` did not hold.
    for d in (dict.fromkeys(behind) if (unsure or workdir is None) else ()):
        back = [f for f in (ask(d, d) or [])
                if isinstance(f, dict) and f.get("code") == "shared-tree"]
        if back:
            return deny(_refusal(back[0], "a `cd` in this command may not hold, and the write "
                                 "would then land in this shared tree", named=False))

    shared = [f for f in findings if isinstance(f, dict) and f.get("code") == "shared-tree"]
    if not shared:
        return 0

    f = shared[0]
    root = (f.get("workdirs") or [workdir or cwd])[0]
    try:
        form = staging_form(command, cwd, root)
    except Exception:
        form = _no("this command could not be read")
    if form.ok and form.paths:
        why = _owned(form, workdir or cwd, cwd, root, payload.get("session_id") or "")
        if not why:
            return 0
        return deny(_refusal(f, why))
    return deny(_refusal(f, form.reason or "this command is not an explicit list of files",
                         named=workdir is not None))


def _owned(form, tree, cwd, root, session):
    """"" when every named path is safe to stage; otherwise why not. Fail-closed."""
    found = ask(tree, cwd, form.paths, session)
    if found is None:
        return "the board could not be asked whether another session claims these files"
    claimed = [c for c in found if isinstance(c, dict) and c.get("code") == "claimed-path"]
    if claimed:
        lines = "; ".join(f"{c.get('detail', '')} by {', '.join(c.get('sessions') or [])}"
                          for c in claimed)
        return f"these paths are claimed by another session in this tree: {lines}"
    if form.bare_commit:
        staged = staged_paths(root)
        if staged is None:
            return ("the bare `git commit` would commit whatever is staged, and the index could "
                    "not be read. Name the files: `git commit -s -m '...' -- <file> <file>`")
        extra = sorted(set(staged) - set(form.added))
        if extra:
            return ("the bare `git commit` would also commit files this command did not add, "
                    f"already staged in the index: {', '.join(extra)}. Name your files instead: "
                    "`git commit -s -m '...' -- <file> <file>`, which commits only those")
    return ""


def _literal_cd(command, cwd):
    """(new_cwd, rest) for a leading `cd <literal dir>` or `pushd <literal dir>`, else None.

    The `cd` must be the first command, with exactly one argument, no options, and a name
    that needs no expansion, to a directory that exists and can be entered. It may be followed
    by `&&`, `;` or a newline. With `&&` the rest of that and-list runs only if the `cd`
    worked; with `;` or a newline it runs either way -- but a `cd` to an existing, searchable,
    literal directory does not fail, so in every accepted form the rest runs there. Lines
    after the first run there too, because a `cd` persists for the rest of the script; that is
    why a heredoc commit message on later lines no longer defeats this (2026-11-03).

    Anything less certain -- `||`, a pipe, `$VAR`, a backtick, a subshell, a missing or
    unsearchable directory, a relative name while CDPATH is set -- stays unresolved, and the
    gate falls back to the session's own tree plus every tree the command names.
    """
    quote, i, n = None, 0, len(command)
    sep = None
    while i < n:
        ch = command[i]
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "\\":
            if i + 1 < n and command[i + 1] == "\n":
                return None  # a line continuation: the `cd` line is not what it looks like
            i += 1
        elif command.startswith("&&", i):
            sep = 2
            break
        elif ch in ";\n":
            sep = 1
            break
        elif ch in "|&()<>`$#{}":
            return None
        i += 1
    if sep is None:
        return None
    head, rest = command[:i], command[i + sep:]
    joined_by_and = sep == 2
    if rest.lstrip(" \t\n").startswith(("&", "|", ";")):
        return None  # `cd /x\n&& git ...` is a syntax error: nothing runs (Copilot on PR #7)
    if any(not c.isprintable() and c != "\t" for c in head):
        # shlex reads `\r` and friends as whitespace; bash keeps them in the name, the `cd`
        # fails, and after a `;` the rest runs in the session's tree (PR #7, finding 3).
        return None
    try:
        argv = shlex.split(head)
    except ValueError:
        return None
    if (len(argv) != 2 or argv[0] not in ("cd", "pushd")
            or argv[1].startswith(("-", "+"))):
        return None
    target = argv[1]
    if target.startswith("~"):
        # Only an unquoted leading `~` is expanded by bash; `cd '~'` names a directory called
        # `~` (PR #7, finding 2).
        raw = head.lstrip()[len(argv[0]):].strip()
        if not raw.startswith("~") or any(c in raw for c in "'\"\\"):
            return None  # any quoting in the word can stop bash expanding it: `~"/x"`
        target = os.path.expanduser(target)
    if any(c in target for c in "$`*?[{}~"):
        return None
    if (os.environ.get("CDPATH") and not os.path.isabs(target)
            and target not in (".", "..") and not target.startswith(("./", "../"))):
        return None  # bash would search CDPATH first; the join below might be the wrong dir
    joined = os.path.join(cwd, target)
    if ".." in target.split("/") and not os.path.isdir(joined):
        # `missing/../shared` normalises to a directory that exists, but bash fails the `cd`
        # on the missing component (Copilot on PR #7). The kernel walks every component of
        # the unnormalised path, so this is the check bash's own makes.
        return None
    target = os.path.normpath(joined)
    if not os.path.isdir(target) or not os.access(target, os.X_OK):
        return None
    if os.path.realpath(joined) != os.path.realpath(target):
        # A symlink before a `..`: bash's logical `cd` and the physical path disagree, and
        # which one bash takes depends on what exists. Not followed; the fallback asks both
        # (hostile fix pass on PR #7, finding 1).
        return None
    if not rest.strip():
        return None
    return target, rest, joined_by_and and _runs_only_after(rest)


def _runs_only_after(rest):
    """True when all of `rest` runs only if the `cd` before its `&&` succeeded.

    That holds for one logical line whose only operators are `&&` and `|`. A `;`, `||`, `&`
    or a later line runs whatever the `cd` did, in the directory it left -- and the existence
    check is not atomic with the shell's `cd`, so "the directory exists" was never a promise
    that it would hold (Copilot on PR #7, reversing the first version of this rule).
    """
    lines = [ln for ln in _logical_lines(rest) if ln.strip()]
    if len(lines) != 1:
        return False
    # posix=False keeps quotes on the token, so a quoted `';'` is a word, not a separator
    # (hostile fix pass on PR #7, finding 3).
    lexer = shlex.shlex(lines[0], posix=False, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return False
    for t in tokens:
        if t in ("&&", "|"):
            continue
        if t in OPERATORS or (set(t) <= set("();<>|&") and (
                t in ("||", "|&") or set(t) & set("();") or t.strip("&") == "")):
            return False
    return True


def _refusal(f, why, named=True):
    who = os.environ.get("SESSION_COORD_USER", "").strip() or "the user"
    others = ", ".join(str(s) for s in (f.get("sessions") or [])) or "another session"
    by_design = f.get("severity") != "block"
    text = (
        f"This working tree is shared with {others}. {f.get('detail', '')}\n\n"
        f"Refused because {why}.\n\n"
        "A command that stages, rewrites or cleans here can take their uncommitted files with "
        "it -- that came within one commit of being real in a private infra repo on 2026-09-17, "
        "and `git clean` would have destroyed the untracked half outright.\n\n"
    )
    if not named:
        # The gate could not tell where the write lands, so it asked about the session's own
        # tree -- which may be a different repo from the one the command meant. A worktree is
        # the wrong advice for that; naming the tree is the right one.
        text += (
            "The gate could not tell which tree this command writes to, so it checked this "
            "session's own. If the command is meant for a different repo, name it literally: "
            "`git -C /literal/path add <file>`, or `cd /literal/path && git ...`, and the gate "
            "checks that tree instead.\n\n"
        )
    elif by_design:
        text += f"What this gate accepts here: {f.get('remedy', '')}\n\n"
    else:
        text += (
            f"To commit only your own files, the gate accepts this: {_explicit_remedy()}\n\n"
            f"Otherwise: {f.get('remedy', '')}\n\n"
            "The gate judged the tree this command writes to: a leading literal `cd /path` "
            "(or `pushd`), a `git -C /path`, or else the session's own directory. If the "
            "command was meant for another tree, name it in one of those forms -- a `cd` "
            "later in the command, or one through a variable, is not followed. To move the "
            "session itself into a worktree of its own repo, use the EnterWorktree tool.\n\n"
        )
    return text + (
        "If you believe it is wrong for some other reason, tell the CONDUCTOR "
        f"(`session-coord conductor show`) rather than {who} -- it owns this tooling and can "
        "check your case against the live board. Report what you ran and what you observed; "
        f"do not attach a diagnosis. Routing a tool bug to {who} is the interruption this "
        "package exists to remove."
    )


if __name__ == "__main__":
    sys.exit(main())
